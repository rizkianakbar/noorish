[["Bukankah kami telah melapangkan dadamu (Muhammad)?",["Have not","We expanded","for you","your breast"]],["dan kami pun telah menurunkan beban darimu,",["And We removed","from you","your burden"]],["yang memberatkan punggungmu,",["Which","weighed upon","your back"]],["dan kami tinggikan sebutan (nama)mu bagimu.",["And We raised high","for you","your reputation"]],["Maka sesungguhnya bersama kesulitan ada kemudahan,",["So indeed","with","the hardship","(is) ease"]],["sesungguhnya bersama kesulitan ada kemudahan.",["Indeed","with","the hardship","(is) ease"]],["Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain),",["So when","you have finished","then labor hard"]],["dan hanya kepada Tuhanmulah engkau berharap.",["And to","your Lord","turn your attention"]]]