[["Tahukah kamu (orang) yang mendustakan agama?",["Have you seen","the one who","denies","the Judgment"]],["Maka itulah orang yang menghardik anak yatim,",["Then that","(is) the one who","repulses","the orphan"]],["dan tidak mengajak memberi makan orang miskin.",["And (does) not","feel the urge","to","feed","the poor"]],["Maka celakalah orang yang salat,",["So woe","to those who pray"]],["(yaitu) orang-orang yang lalai terhadap salatnya,",["Those who","[they]","about","their prayers","(are) neglectful"]],["yang berbuat riya`,",["Those who","[they]","make show"]],["dan enggan (memberikan) bantuan.",["And they deny","[the] small kindnesses"]]]