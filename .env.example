# Copy to .env.local (gitignored). Loaded by dev, db:* and test.

# Supabase Postgres (Project → Connect). Use a separate dev project here, never
# production: tests write to it (inside rolled-back transactions) and
# `bun db:seed` truncates it.
#
# The direct host (db.<ref>.supabase.co) is IPv6-only. If your network or host
# has no IPv6 (Vercel doesn't), use the pooler instead:
#   app on Vercel:      ...@aws-0-<region>.pooler.supabase.com:6543/postgres  (transaction mode)
#   migrations/local:   ...@aws-0-<region>.pooler.supabase.com:5432/postgres  (session mode)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.eysgrjpfniajcavwsmrq.supabase.co:5432/postgres"

# Optional in dev (a dev-only default is used). Required in production:
# openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Prayer notifications (Web Push). Optional: without the keys the app doesn't
# offer them. Generate a pair once with: bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# Bearer token for /api/push/send; required in production for notifications
# to be sent. openssl rand -hex 32, then schedule the sender: bun push:cron
# CRON_SECRET=
